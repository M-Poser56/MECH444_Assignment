FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1.5; //see calculations

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    outlet
    {
        type            zeroGradient;
    }
    body
    {
        type            kqRWallFunction; //default k epsilon model wall function
    }
    "(top|bottom)"
    {
        type            zeroGradient;
    }
    sides
    {
        type            zeroGradient; //3D
    }
}


