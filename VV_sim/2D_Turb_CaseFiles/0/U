FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

alpha  0;
ux     #eval{ 1.5*cos(degToRad($alpha)) };
uy     #eval{ 1.5*sin(degToRad($alpha)) }; 

internalField   uniform ($ux $uy 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    outlet
    {
        type            zeroGradient;
    }
    airfoil
    {
        type            noSlip;
    }
    "(top|bottom)" 
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}


