FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// gmshToFoam writes every patch as type 'patch'; run changeDictionaryDict
// after it to set the wall types. Names must match the gmsh Physical Surfaces.

boundary
{
    ground
    {
        type            wall;
    }

    "fairing.*"
    {
        type            wall;
    }
}


