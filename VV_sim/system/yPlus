Description
    Calculates the turbulence y+, outputting the data as a yPlus field.

\*---------------------------------------------------------------------------*/

yPlus
{
    type            yPlus;
    libs            (fieldFunctionObjects);

    enabled         true;
    executeControl  timeStep;
    executeInterval 10;
    writeControl    writeTime;
}

