forceCoeffs
{
    type            forceCoeffs;

    libs            (forces);

    writeControl    timeStep;
    timeInterval    1;

    log             no;

    #include        "caseParameters"

    magUInf         $Umag;       // Freestream velocity
    // lRef, Aref and CofR come from caseParameters

    patches         ("fairing.*");
    rho             rhoInf;      // Indicates incompressible
    rhoInf          1;           // Required when rho = rhoInf
    liftDir         (0 0 1);     // +z is up
    dragDir         (-1 0 0);    // drag acts along the flow (-x)
    pitchAxis       (0 1 0);
}


