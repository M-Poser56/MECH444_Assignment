FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "<system>/caseParameters"

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform ($Ux 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           $internalField;
    }
    ground
    {
        type            fixedValue;           // moving ground: road moves with the freestream
        value           $internalField;
    }
    "(top|sides)"
    {
        type            slip;
    }
    "fairing.*"
    {
        type            noSlip;
    }
}


