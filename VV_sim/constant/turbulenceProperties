FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType      RAS;

RAS
{
    RASModel        kOmegaSST;      // all of k, epsilon, omega, nuTilda exist in 0/, so
                                    // kEpsilon / realizableKE / SpalartAllmaras also work
    turbulence      on;

    printCoeffs     on;
}

