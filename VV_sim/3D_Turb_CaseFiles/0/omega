FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 13.05; //see calculations (hope they're right!)

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    outlet
    {
        type            zeroGradient;
    }
    body
    {
        type            omegaWallFunction; //basic k epsilon default wall function
        value           $internalField;
    }
    "(top|bottom)"
    {
        type            zeroGradient;
    }
    sides
    {
        type            zeroGradient;
    }
}


