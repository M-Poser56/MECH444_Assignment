FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

ux  14; //14m/s is ~ 50km/h

internalField   uniform ($ux 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    outlet
    {
        type            zeroGradient;
    }
    body //this is the kart fairing surfaces
    {
        type            noSlip;
    }
    "(top|bottom)" 
    {
        type            zeroGradient; //double check this, but it's fine for now. Don't care about ground effect
    }
    sides
    {
        type            zeroGradient; //I had to change this from the airfoil example, makes it 3D
    }
}


